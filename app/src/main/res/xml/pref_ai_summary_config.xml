<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="方案管理">

        <ListPreference
            app:key="aiActiveProfileName"
            app:title="当前方案"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="ai_profile_add"
            app:title="新建方案"
            app:summary="创建一个新的AI配置方案" />

        <Preference
            app:key="ai_profile_rename"
            app:title="重命名当前方案" />

        <Preference
            app:key="ai_profile_delete"
            app:title="删除当前方案"
            app:summary="删除后不可恢复" />

    </PreferenceCategory>

    <PreferenceCategory app:title="当前方案设置">

        <EditTextPreference
            app:key="ai_profile_api_key"
            app:title="@string/ai_summary_api_key"
            app:summary="API Key" />

        <EditTextPreference
            app:key="ai_profile_api_url"
            app:title="@string/ai_summary_api_url"
            app:summary="API URL" />

        <ListPreference
            app:key="ai_profile_api_format"
            app:title="@string/ai_summary_api_format"
            app:summary="API Format"
            app:entries="@array/ai_summary_api_format_entries"
            app:entryValues="@array/ai_summary_api_format_values"
            app:defaultValue="openai" />

        <EditTextPreference
            app:key="ai_profile_model_id"
            app:title="模型ID"
            app:summary="Model ID" />

        <EditTextPreference
            app:key="ai_profile_system_prompt"
            app:title="@string/ai_summary_system_prompt"
            app:summary="System Prompt" />

    </PreferenceCategory>

    <PreferenceCategory app:title="通用设置">

        <EditTextPreference
            app:key="pref_ai_summary_chapter_count"
            app:title="@string/ai_summary_chapter_count"
            app:summary="@string/ai_summary_chapter_count_desc"
            app:persistent="true"
            app:defaultValue="3"
            android:inputType="number" />

        <EditTextPreference
            app:key="aiSummaryPreCacheDelay"
            app:title="@string/ai_summary_pre_cache_delay"
            app:persistent="true"
            app:defaultValue="10"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="aiSummaryClearCache"
            app:title="@string/ai_summary_clear_cache"
            app:summary="@string/ai_summary_clear_cache_desc" />

    </PreferenceCategory>

    <Preference
        app:key="aiSummaryHelp"
        app:title="@string/ai_summary_help"
        app:summary="@string/ai_summary_help_desc" />

</PreferenceScreen>